@{
    ViewData["Title"] = "Mot de passe oublié";
    Layout = "_Layout";
}
@model inspect_san.ViewModels.ForgotPasswordViewModel

<div class="isp-login-card">
    <h1 class="h4 mb-3">Mot de passe oublié</h1>
    @if (!string.IsNullOrEmpty(Model.Info))
    {
        <div class="alert alert-info">@Model.Info</div>
        <a class="btn btn-primary" asp-action="Login">Retour à la connexion</a>
    }
    else
    {
        <p class="text-secondary small">Saisissez l’e-mail de votre compte. Un lien de réinitialisation sera envoyé si le compte existe.</p>
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>
        </form>
        <p class="mt-3 mb-0"><a asp-action="Login">Retour</a></p>
    }
</div>
