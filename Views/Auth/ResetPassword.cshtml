@{
    ViewData["Title"] = "Nouveau mot de passe";
    Layout = "_Layout";
}
@model inspect_san.ViewModels.ResetPasswordViewModel

<div class="isp-login-card">
    <h1 class="h4 mb-3">Nouveau mot de passe</h1>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div class="mb-3">
            <label asp-for="MotDePasse" class="form-label"></label>
            <input asp-for="MotDePasse" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="MotDePasse" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Confirmation" class="form-label"></label>
            <input asp-for="Confirmation" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Confirmation" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Enregistrer</button>
    </form>
</div>
