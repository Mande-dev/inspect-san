@using System.Text.Json
@{
    ViewData["Title"] = "Paramètres";
    ViewBag.PageKey = "parametres";
    var tab = ViewBag.Tab as string ?? "categories";
    var items = (List<RefItem>)ViewBag.Items;
    var canGerer = ViewBag.CanGererParametres as bool? == true;
    var tabs = new[] {
        ("categories", "Catégories"),
        ("produits", "Produits utilisés"),
        ("outils", "Outils utilisés")
    };
}
<div id="parametresPage" data-tab="@tab" data-can-gerer="@(canGerer ? "1" : "0")">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4 isp-page-head">
        <div>
            <h2 class="mb-1">Paramètres</h2>
            <p class="text-secondary mb-0">@(canGerer ? "Référentiels métier. Le code est attribué automatiquement." : "Consultation des référentiels métier.")</p>
        </div>
        @if (canGerer)
        {
            <button type="button" class="btn btn-primary" id="btnNewRef" data-bs-toggle="modal" data-bs-target="#refModal">
                <i class="ti ti-plus me-1"></i> Ajouter
            </button>
        }
    </div>

    <ul class="nav nav-tabs mb-3" id="parametresTabs" role="tablist">
        @foreach (var t in tabs)
        {
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link @(tab == t.Item1 ? "active" : "")"
                        data-tab="@t.Item1"
                        role="tab">@t.Item2</button>
            </li>
        }
    </ul>

    <div class="card card-lg">
        <div class="table-responsive">
            <table class="table table-hover mb-0 js-paginated-table" id="parametresTable">
                <thead class="table-light" id="parametresThead">
                    <tr>
                        <th style="width:5rem">Code</th>
                        <th>Libellé</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="parametresTbody">
                @foreach (var i in items)
                {
                    <tr>
                        <td class="text-secondary">@i.Code</td>
                        <td>@(i.Libelle ?? i.Nom)</td>
                        <td class="text-end text-nowrap">
                            @if (canGerer)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary ref-edit"
                                        data-json="@JsonSerializer.Serialize(i)"
                                        data-bs-toggle="modal" data-bs-target="#refModal">
                                    <i class="ti ti-edit"></i>
                                </button>
                                <form class="d-inline js-delete-ref" data-code="@i.Code">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade isp-modal" id="refModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="SaveParametre" method="post" class="modal-content" id="refForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tab" id="refTab" value="@tab" />
            <input type="hidden" name="Code" id="refCode" value="0" />
            <div class="modal-header">
                <h5 class="modal-title" id="refTitle">Ajouter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3" id="refCodeGroup" hidden>
                    <label class="form-label" for="refCodeDisplay">Code</label>
                    <input type="text" id="refCodeDisplay" class="form-control" readonly tabindex="-1" />
                    <div class="form-text">Code technique auto-incrémenté (non modifiable).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="refNom">Libellé</label>
                    <input name="Nom" id="refNom" class="form-control" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/parametres.js" asp-append-version="true"></script>
}
