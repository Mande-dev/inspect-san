@model List<Rapport>
@using System.Text.Json
@using inspect_san.Helpers
@{
    ViewData["Title"] = "Rapports d'inspection";
    var fiches = (List<FicheControle>)ViewBag.FichesValidees;
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var allFiches = (List<FicheControle>)(ViewBag.Fiches ?? fiches);
    var canCreer = ViewBag.CanCreerRapport as bool? == true;
    var peutDeposerMap = ViewBag.RapportPeutDeposer as Dictionary<string, bool> ?? new Dictionary<string, bool>();
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Rapports d'inspection</h2>
        <p class="text-secondary mb-0">Synthèses basées sur les fiches validées. Règle : chaque fiche ne peut être déposée qu’une seule fois.</p>
    </div>
    @if (canCreer)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#rapportModal" id="newRapport"><i class="ti ti-plus me-1"></i>Nouveau rapport</button>
    }
</div>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="rapportsTable"
               data-can-creer="@(canCreer ? "1" : "0")">
            <thead class="table-light"><tr><th>N°</th><th>École</th><th>Synthèse</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == r.EcoleId);
                var ficheLite = r.FicheIds.Select(fid =>
                {
                    var f = allFiches.FirstOrDefault(x => x.Id == fid);
                    return new { Numero = f?.Numero ?? fid, Recommandation = f?.RecommandationPreliminaire ?? "—" };
                }).ToList();
                var peutDeposer = canCreer && r.Statut == "brouillon"
                    && peutDeposerMap.GetValueOrDefault(r.Id);
                <tr data-statut="@r.Statut">
                    <td class="fw-semibold">@r.Numero</td>
                    <td>@(eco?.Denomination ?? "—")</td>
                    <td class="small text-truncate" style="max-width:280px">@(string.IsNullOrEmpty(r.Synthese) ? "—" : r.Synthese)</td>
                    <td><span class="badge bg-secondary-subtle text-dark">@r.Statut</span></td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-voir-rapport"
                                data-id="@r.Id"
                                data-ecole="@r.EcoleId"
                                data-statut="@r.Statut"
                                data-synthese="@r.Synthese"
                                data-fiches="@JsonSerializer.Serialize(r.FicheIds)"
                                data-readonly="1"
                                data-bs-toggle="modal" data-bs-target="#rapportModal"
                                title="Voir"><i class="ti ti-eye"></i></button>
                        @if (canCreer && r.Statut == "brouillon")
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-rapport"
                                    data-id="@r.Id"
                                    data-ecole="@r.EcoleId"
                                    data-statut="@r.Statut"
                                    data-synthese="@r.Synthese"
                                    data-fiches="@JsonSerializer.Serialize(r.FicheIds)"
                                    data-readonly="0"
                                    data-bs-toggle="modal" data-bs-target="#rapportModal"
                                    title="Modifier"><i class="ti ti-edit"></i></button>
                            @if (peutDeposer)
                            {
                                <form asp-action="DeposerRapport" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-outline-primary" title="Déposer"><i class="ti ti-send"></i></button></form>
                            }
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary print-btn"
                                data-title="Rapport @r.Numero"
                                data-json="@JsonUi.Serialize(r)"
                                data-ecole="@JsonUi.Serialize(eco)"
                                data-fiches-lite="@JsonUi.Serialize(ficheLite)"><i class="ti ti-printer"></i></button>
                        @if (canCreer && r.Statut == "brouillon")
                        {
                            <form asp-action="DeleteRapport" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="rapportModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SaveRapport" method="post" class="modal-content" id="rapportForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-report-analytics"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Rapport</p>
                        <h5 class="modal-title" id="rapportTitle">Nouveau rapport</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="rapportId" />
                <input type="hidden" name="EcoleId" id="rapportEcole" />
                <input type="hidden" name="Statut" id="rapportStatut" value="brouillon" />
                <div class="isp-modal-section">
                    <h6 class="isp-modal-section-title"><i class="ti ti-list-check"></i> Fiches validées disponibles <span class="text-danger">*</span></h6>
                    <p class="small text-secondary mb-2">Seules les fiches non encore déposées sont listées.</p>
                    <div class="isp-check-list" id="fichesBox">
                    @foreach (var f in fiches)
                    {
                        var eco = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
                        <div class="form-check">
                            <input class="form-check-input fiche-check" type="checkbox" name="ficheIds" value="@f.Id" data-ecole="@f.EcoleId" id="f_@f.Id" />
                            <label class="form-check-label" for="f_@f.Id">@f.Numero — @(eco?.Denomination)</label>
                        </div>
                    }
                    @if (!fiches.Any())
                    {
                        <p class="text-secondary small mb-0">Aucune fiche validée disponible (toutes déjà déposées ou aucune validée).</p>
                    }
                    </div>
                </div>
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-align-left"></i> Synthèse</h6>
                    <textarea name="Synthese" id="rapportSynthese" class="form-control" rows="4" placeholder="Synthèse automatique possible après sélection des fiches"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button class="btn btn-primary" id="rapportSave">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/rapports.js" asp-append-version="true"></script>
}
