@model List<FicheControle>
@using System.Text.Json
@using inspect_san.Helpers
@{
    ViewData["Title"] = "Fiches de contrôle";
    var ordres = (List<OrdreMission>)ViewBag.OrdresSignes;
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var chefs = (List<Chef>)ViewBag.Chefs;
    var allOrdres = (List<OrdreMission>)(ViewBag.AllOrdres ?? ordres);
    var etats = (IEnumerable<string>)ViewBag.Etats;
    var produits = (IEnumerable<string>)ViewBag.Produits;
    var recommandations = (IEnumerable<string>)ViewBag.Recommandations;
    var canValider = ViewBag.CanValider as bool? == true;
    var canCreer = ViewBag.CanCreerFiche as bool? == true;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Fiches de contrôle</h2>
        <p class="text-secondary mb-0">Constats sanitaires. Circuit : brouillon → soumettre au chef → Lu et approuvé.</p>
    </div>
    @if (canCreer)
    {
        <button type="button" class="btn btn-primary" id="newFiche" data-bs-toggle="modal" data-bs-target="#ficheModal">
            <i class="ti ti-plus me-1"></i>Nouvelle fiche
        </button>
    }
</div>
<form method="get" class="row g-2 mb-4" id="fichesFilter">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="N° de fiche…" /></div>
    <div class="col-md-4">
        <select name="statut" class="form-select">
            <option value="">Tous les statuts</option>
            <option value="brouillon" selected="@(ViewBag.Statut as string == "brouillon")">Brouillon</option>
            <option value="validee" selected="@(ViewBag.Statut as string == "validee")">Validée</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrer</button></div>
</form>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="fichesTable" data-can-valider="@(canValider ? "1" : "0")" data-can-creer="@(canCreer ? "1" : "0")">
            <thead class="table-light"><tr><th>Numéro</th><th>École</th><th>État</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                var ecole = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
                <tr>
                    <td class="fw-semibold">@f.Numero</td>
                    <td>@(ecole?.Denomination ?? "—")</td>
                    <td>@(f.SectionBatiments?.EtatGeneral ?? "—")</td>
                    <td><span class="badge @(f.Statut == "validee" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">@f.Statut</span></td>
                    <td class="text-end text-nowrap">
                        @if (canCreer || canValider)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary fiche-edit" data-json="@JsonUi.Serialize(f)" data-bs-toggle="modal" data-bs-target="#ficheModal" title="@(canCreer ? "Modifier" : "Consulter")"><i class="ti ti-@(canCreer ? "edit" : "eye")"></i></button>
                        }
                        @if (canCreer && f.Statut == "brouillon")
                        {
                            <form asp-action="SoumettreFiche" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@f.Id" /><button class="btn btn-sm btn-outline-warning" title="Soumettre au chef"><i class="ti ti-send"></i> Soumettre</button></form>
                        }
                        @if (canValider && f.Statut == "en_attente_validation")
                        {
                            <form asp-action="ValiderFiche" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@f.Id" /><button class="btn btn-sm btn-outline-success" title="Lu et approuvé"><i class="ti ti-check"></i> Lu et approuvé</button></form>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary print-btn"
                                data-title="Fiche @f.Numero"
                                data-json="@JsonUi.Serialize(f)"
                                data-ecole="@JsonUi.Serialize(ecole)"
                                data-chef="@JsonUi.Serialize(chefs.FirstOrDefault(c => c.Id == f.ChefId))"
                                data-ordre="@JsonUi.Serialize(allOrdres.FirstOrDefault(o => o.Id == f.OrdreMissionId))"><i class="ti ti-printer"></i></button>
                        @if (canCreer && f.Statut == "brouillon")
                        {
                            <form asp-action="DeleteFiche" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@f.Id" /><button class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="ficheModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <form asp-action="SaveFiche" method="post" class="modal-content" id="ficheForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-clipboard-check"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Fiche de contrôle</p>
                        <h5 class="modal-title mb-1" id="ficheTitle">Nouvelle fiche</h5>
                        <p class="text-secondary small mb-0" id="ficheStepHint">Étape 1 sur 4 — Généralités</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body pt-3">
                <input type="hidden" name="Id" id="ficheId" />
                <input type="hidden" name="PhotosJson" id="photosJson" value="[]" />

                <div class="fiche-stepper mb-4" id="ficheStepper" role="navigation" aria-label="Étapes du formulaire">
                    <div class="fiche-step active" data-step="1">
                        <span class="fiche-step-num">1</span>
                        <span class="fiche-step-label">Généralités</span>
                    </div>
                    <div class="fiche-step-line"></div>
                    <div class="fiche-step" data-step="2">
                        <span class="fiche-step-num">2</span>
                        <span class="fiche-step-label">Bâtiments</span>
                    </div>
                    <div class="fiche-step-line"></div>
                    <div class="fiche-step" data-step="3">
                        <span class="fiche-step-num">3</span>
                        <span class="fiche-step-label">Impact 7 %</span>
                    </div>
                    <div class="fiche-step-line"></div>
                    <div class="fiche-step" data-step="4">
                        <span class="fiche-step-num">4</span>
                        <span class="fiche-step-label">Constat</span>
                    </div>
                </div>

                <div class="fiche-pane" data-pane="1">
                    <div class="isp-modal-section mb-0">
                        <h6 class="isp-modal-section-title"><i class="ti ti-map-pin"></i> Mission et établissement</h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Ordre de mission <span class="text-danger">*</span></label>
                                <select name="OrdreMissionId" id="ficheOrdre" class="form-select" required>
                                    <option value="">Sélectionner…</option>
                                    @foreach (var o in ordres)
                                    {
                                        var e = ecoles.FirstOrDefault(x => x.Id == o.EcoleId);
                                        var c = chefs.FirstOrDefault(x => x.EcoleId == o.EcoleId);
                                        <option value="@o.Id" data-ecole="@(e?.Denomination)" data-chef="@(c?.NomComplet)">@o.Numero — @(e?.Denomination)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Statut</label>
                                <select id="ficheStatut" class="form-select" disabled>
                                    <option value="brouillon">Brouillon</option>
                                    <option value="en_attente_validation">En attente de validation</option>
                                    <option value="validee">Validée</option>
                                </select>
                                <input type="hidden" name="Statut" value="brouillon" id="ficheStatutHidden" />
                                <div class="form-text">Le statut évolue via « Soumettre » puis « Lu et approuvé ».</div>
                            </div>
                            <div class="col-12">
                                <div class="alert alert-light border mb-0">
                                    <div class="row g-2">
                                        <div class="col-sm-6"><span class="text-secondary small d-block">École</span><strong id="infoEcole">—</strong></div>
                                        <div class="col-sm-6"><span class="text-secondary small d-block">Chef d'établissement</span><strong id="infoChef">—</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="fiche-pane d-none" data-pane="2">
                    <div class="isp-modal-section mb-0">
                        <h6 class="isp-modal-section-title"><i class="ti ti-building"></i> Bâtiments &amp; infrastructures</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Nombre de bâtiments</label>
                                <input type="number" min="0" name="NombreBatiments" id="ficheBatiments" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">État général</label>
                                <select name="EtatGeneral" id="ficheEtat" class="form-select">
                                    @foreach (var et in etats) { <option value="@et">@et</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nombre d'élèves</label>
                                <input type="number" min="0" name="NombreEleves" id="ficheEleves" class="form-control" />
                            </div>
                            <div class="col-12">
                                <h6 class="isp-modal-section-title mb-2"><i class="ti ti-restroom"></i> Toilettes / latrines</h6>
                                <p class="small text-secondary mb-3">Indiquez d’abord le <strong>nombre de cabines</strong>, puis leur <strong>état</strong>. Le résumé est enregistré automatiquement.</p>
                                <div class="isp-toilet-grid">
                                    <div class="isp-toilet-card">
                                        <div class="isp-toilet-card-head">
                                            <span class="isp-toilet-card-icon" aria-hidden="true"><i class="ti ti-gender-female"></i></span>
                                            <div>
                                                <p class="isp-toilet-card-title">Filles</p>
                                                <p class="isp-toilet-card-hint">Cabines réservées aux filles</p>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-5">
                                                <label class="form-label" for="ficheFillesNb">Nombre</label>
                                                <input type="number" min="0" max="99" class="form-control" id="ficheFillesNb" placeholder="0" />
                                            </div>
                                            <div class="col-7">
                                                <label class="form-label" for="ficheFillesEtat">État</label>
                                                <select class="form-select" id="ficheFillesEtat">
                                                    <option value="">Choisir…</option>
                                                    <option value="Fonctionnelles">Fonctionnelles</option>
                                                    <option value="Partiellement fonctionnelles">Partiellement fonctionnelles</option>
                                                    <option value="Hors service">Hors service</option>
                                                    <option value="Absentes">Absentes</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="isp-toilet-preview" id="ficheFillesPreview">Résumé : <strong>—</strong></div>
                                        <input type="hidden" name="ToilettesFilles" id="ficheFilles" />
                                    </div>
                                    <div class="isp-toilet-card">
                                        <div class="isp-toilet-card-head">
                                            <span class="isp-toilet-card-icon" aria-hidden="true"><i class="ti ti-gender-male"></i></span>
                                            <div>
                                                <p class="isp-toilet-card-title">Garçons</p>
                                                <p class="isp-toilet-card-hint">Cabines réservées aux garçons</p>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-5">
                                                <label class="form-label" for="ficheGarconsNb">Nombre</label>
                                                <input type="number" min="0" max="99" class="form-control" id="ficheGarconsNb" placeholder="0" />
                                            </div>
                                            <div class="col-7">
                                                <label class="form-label" for="ficheGarconsEtat">État</label>
                                                <select class="form-select" id="ficheGarconsEtat">
                                                    <option value="">Choisir…</option>
                                                    <option value="Fonctionnelles">Fonctionnelles</option>
                                                    <option value="Partiellement fonctionnelles">Partiellement fonctionnelles</option>
                                                    <option value="Hors service">Hors service</option>
                                                    <option value="Absentes">Absentes</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="isp-toilet-preview" id="ficheGarconsPreview">Résumé : <strong>—</strong></div>
                                        <input type="hidden" name="ToilettesGarcons" id="ficheGarcons" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="fiche-pane d-none" data-pane="3">
                    <div class="isp-modal-section mb-0">
                        <h6 class="isp-modal-section-title"><i class="ti ti-coin"></i> Frais de fonctionnement (Impact 7 %)</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Montant perçu (FC / $)</label>
                                <input name="MontantPercu" id="ficheMontant" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Produits de nettoyage achetés</label>
                                <div class="d-flex flex-wrap gap-3 mt-1">
                                    @foreach (var p in produits)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input produit-check" type="checkbox" name="ProduitsNettoyage" value="@p" id="prod_@p" />
                                            <label class="form-check-label" for="prod_@p">@p</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Autres produits</label>
                                <input name="ProduitsAutres" id="ficheAutres" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Quantité / Précisions</label>
                                <input name="Quantite" id="ficheQuantite" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="fiche-pane d-none" data-pane="4">
                    <div class="isp-modal-section mb-0">
                        <h6 class="isp-modal-section-title"><i class="ti ti-notes"></i> Observations, recommandation &amp; photos</h6>
                        <div class="mb-3">
                            <label class="form-label">Observations générales</label>
                            <textarea name="Observations" id="ficheObs" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Recommandation préliminaire</label>
                            <select name="RecommandationPreliminaire" id="ficheReco" class="form-select">
                                @foreach (var r in recommandations) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="small text-uppercase text-secondary">Photos constatées</strong>
                            <label class="btn btn-sm btn-outline-primary mb-0" id="photoLabel"><i class="ti ti-camera me-1"></i>Ajouter<input type="file" id="photoInput" accept="image/*" class="d-none" multiple /></label>
                        </div>
                        <div id="photoList" class="row g-2"></div>
                        <p class="small text-secondary mb-0" id="photoEmpty">Aucune photo jointe.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="fichePrev" disabled><i class="ti ti-arrow-left me-1"></i>Précédent</button>
                    <button type="button" class="btn btn-primary" id="ficheNext">Suivant<i class="ti ti-arrow-right ms-1"></i></button>
                    <button type="submit" class="btn btn-success d-none" id="ficheSave"><i class="ti ti-device-floppy me-1"></i>Enregistrer</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
  var photos = [];
  var step = 1;
  var totalSteps = 4;
  var locked = false;
  var form = document.getElementById('ficheForm');
  var hints = {
    1: 'Étape 1 sur 4 — Généralités',
    2: 'Étape 2 sur 4 — Bâtiments & infrastructures',
    3: 'Étape 3 sur 4 — Impact 7 %',
    4: 'Étape 4 sur 4 — Observations & photos'
  };

  var toiletEtats = [
    'Fonctionnelles',
    'Partiellement fonctionnelles',
    'Hors service',
    'Absentes'
  ];

  function composeToilet(nbEl, etatEl) {
    var nb = (nbEl.value || '').trim();
    var etat = (etatEl.value || '').trim();
    if (etat === 'Absentes') return '0 · Absentes';
    if (nb !== '' && etat) return nb + ' · ' + etat;
    if (nb !== '') return nb + ' cabine(s)';
    if (etat) return etat;
    return '';
  }

  function syncToiletPair(nbId, etatId, hiddenId, previewId) {
    var nbEl = document.getElementById(nbId);
    var etatEl = document.getElementById(etatId);
    var hidden = document.getElementById(hiddenId);
    var preview = document.getElementById(previewId);
    if (!nbEl || !etatEl || !hidden || !preview) return;
    var absentes = etatEl.value === 'Absentes';
    if (absentes) nbEl.value = '0';
    nbEl.disabled = locked || absentes;
    etatEl.disabled = locked;
    var value = composeToilet(nbEl, etatEl);
    hidden.value = value;
    preview.innerHTML = 'Résumé : <strong>' + (value || '—') + '</strong>';
  }

  function syncAllToilets() {
    syncToiletPair('ficheFillesNb', 'ficheFillesEtat', 'ficheFilles', 'ficheFillesPreview');
    syncToiletPair('ficheGarconsNb', 'ficheGarconsEtat', 'ficheGarcons', 'ficheGarconsPreview');
  }
  window.syncFicheToilets = syncAllToilets;

  function parseToilet(raw, nbId, etatId) {
    var nbEl = document.getElementById(nbId);
    var etatEl = document.getElementById(etatId);
    if (!nbEl || !etatEl) return;
    nbEl.value = '';
    etatEl.value = '';
    var text = (raw || '').trim();
    if (!text) return;

    var lower = text.toLowerCase();
    var matchedEtat = '';
    toiletEtats.forEach(function (e) {
      if (lower.indexOf(e.toLowerCase()) >= 0) matchedEtat = e;
    });
    // Compat anciens libellés
    if (!matchedEtat) {
      if (/fonctionnell/.test(lower) && /partiel/.test(lower)) matchedEtat = 'Partiellement fonctionnelles';
      else if (/fonctionnell|ok|bon/.test(lower)) matchedEtat = 'Fonctionnelles';
      else if (/hors\s*service|d[eé]grad|inutilis/.test(lower)) matchedEtat = 'Hors service';
      else if (/absent|inexistant|aucune/.test(lower)) matchedEtat = 'Absentes';
    }

    var nbMatch = text.match(/(\d+)/);
    if (nbMatch) nbEl.value = nbMatch[1];
    if (matchedEtat) etatEl.value = matchedEtat;
    if (matchedEtat === 'Absentes' && !nbMatch) nbEl.value = '0';
  }

  ['ficheFillesNb', 'ficheFillesEtat', 'ficheGarconsNb', 'ficheGarconsEtat'].forEach(function (id) {
    document.getElementById(id)?.addEventListener('input', syncAllToilets);
    document.getElementById(id)?.addEventListener('change', syncAllToilets);
  });

  function syncSchool() {
    var o = document.getElementById('ficheOrdre').selectedOptions[0];
    document.getElementById('infoEcole').textContent = (o && o.dataset.ecole) || '—';
    document.getElementById('infoChef').textContent = (o && o.dataset.chef) || '—';
  }

  function renderPhotos() {
    document.getElementById('photosJson').value = JSON.stringify(photos);
    var box = document.getElementById('photoList');
    document.getElementById('photoEmpty').style.display = photos.length ? 'none' : 'block';
    box.innerHTML = photos.map(function (p, i) {
      return '<div class="col-md-4"><div class="border rounded p-2 text-center"><img src="' + (p.Url || p.url || '') + '" class="img-fluid rounded mb-1" style="max-height:100px;object-fit:cover" onerror="this.style.display=\'none\'"><div class="small">' + (p.Legende || p.legende || p.Nom || '') + '</div>' +
        (locked ? '' : '<button type="button" class="btn btn-link btn-sm text-danger p-0" data-i="' + i + '">Retirer</button>') +
        '</div></div>';
    }).join('');
  }

  function goStep(n) {
    step = Math.max(1, Math.min(totalSteps, n));
    document.querySelectorAll('.fiche-pane').forEach(function (p) {
      p.classList.toggle('d-none', +p.dataset.pane !== step);
    });
    document.querySelectorAll('.fiche-step').forEach(function (s) {
      var sn = +s.dataset.step;
      s.classList.toggle('active', sn === step);
      s.classList.toggle('done', sn < step);
    });
    document.getElementById('ficheStepHint').textContent = hints[step];
    document.getElementById('fichePrev').disabled = step === 1;
    document.getElementById('ficheNext').classList.toggle('d-none', step === totalSteps);
    document.getElementById('ficheSave').classList.toggle('d-none', step !== totalSteps || locked);
  }

  function validateStep(n) {
    if (n === 1) {
      var ordre = document.getElementById('ficheOrdre');
      if (!ordre.value) {
        ordre.classList.add('is-invalid');
        ordre.focus();
        return false;
      }
      ordre.classList.remove('is-invalid');
    }
    if (n === 2) {
      syncAllToilets();
      var fEtat = document.getElementById('ficheFillesEtat');
      var gEtat = document.getElementById('ficheGarconsEtat');
      var fNb = document.getElementById('ficheFillesNb');
      var gNb = document.getElementById('ficheGarconsNb');
      var ok = true;
      [fEtat, gEtat].forEach(function (el) {
        if (!el.value) { el.classList.add('is-invalid'); ok = false; }
        else el.classList.remove('is-invalid');
      });
      [fNb, gNb].forEach(function (el) {
        var etat = el.id === 'ficheFillesNb' ? fEtat.value : gEtat.value;
        if (etat && etat !== 'Absentes' && (el.value === '' || +el.value < 0)) {
          el.classList.add('is-invalid');
          ok = false;
        } else el.classList.remove('is-invalid');
      });
      if (!ok) return false;
    }
    return true;
  }

  document.getElementById('ficheOrdre').addEventListener('change', function () {
    this.classList.remove('is-invalid');
    syncSchool();
  });
  document.getElementById('fichePrev').addEventListener('click', function () { goStep(step - 1); });
  document.getElementById('ficheNext').addEventListener('click', function () {
    if (!validateStep(step)) return;
    goStep(step + 1);
  });
  document.querySelectorAll('.fiche-step').forEach(function (s) {
    s.addEventListener('click', function () {
      var target = +s.dataset.step;
      if (target < step || (target > step && validateStep(step))) goStep(target);
      else if (target === step) return;
      else if (target > step + 1) {
        // avancer étape par étape si validation OK
        var ok = true;
        for (var i = step; i < target; i++) {
          if (!validateStep(i)) { ok = false; break; }
          goStep(i + 1);
        }
        if (ok) goStep(target);
      }
    });
  });

  document.getElementById('photoList').addEventListener('click', function (e) {
    if (locked) return;
    if (e.target.dataset.i != null) { photos.splice(+e.target.dataset.i, 1); renderPhotos(); }
  });
  document.getElementById('photoInput').addEventListener('change', function () {
    Array.from(this.files).forEach(function (f) {
      if (!window.pendingPhotoFiles) window.pendingPhotoFiles = [];
      window.pendingPhotoFiles.push(f);
      photos.push({ Nom: f.name, Legende: f.name, Url: URL.createObjectURL(f) });
    });
    this.value = '';
    renderPhotos();
  });

  function resetWizard(title, isLocked) {
    locked = !!isLocked;
    form.reset();
    photos = [];
    window.pendingPhotoFiles = [];
    renderPhotos();
    document.getElementById('ficheId').value = '';
    document.getElementById('ficheTitle').textContent = title;
    form.querySelectorAll('input,select,textarea').forEach(function (el) {
      if (el.type !== 'hidden' && el.id !== 'photoInput') el.disabled = locked;
    });
    document.getElementById('photoLabel').classList.toggle('d-none', locked);
    document.getElementById('ficheNext').disabled = false;
    document.getElementById('fichePrev').disabled = false;
    syncSchool();
    syncAllToilets();
    goStep(1);
  }

  var canCreerFiche = document.getElementById('fichesTable')?.getAttribute('data-can-creer') === '1';

  document.getElementById('newFiche')?.addEventListener('click', function () {
    if (!canCreerFiche) return;
    resetWizard('Nouvelle fiche', false);
    parseToilet('', 'ficheFillesNb', 'ficheFillesEtat');
    parseToilet('', 'ficheGarconsNb', 'ficheGarconsEtat');
    syncAllToilets();
  });

  function openFiche(btn) {
    var f = api.parseJsonAttr(btn, 'json');
    if (!f) return;
    var sb = f.SectionBatiments || f.sectionBatiments || {};
    var si = f.SectionImpact7 || f.sectionImpact7 || {};
    var statut = f.Statut || f.statut || 'brouillon';
    var isValidee = statut === 'validee';
    var isEnAttente = statut === 'en_attente_validation';
    locked = isValidee || isEnAttente || !canCreerFiche;
    form.reset();
    document.getElementById('ficheId').value = f.Id || f.id || '';
    document.getElementById('ficheOrdre').value = f.OrdreMissionId || f.ordreMissionId || '';
    document.getElementById('ficheStatut').value = statut;
    var hiddenStatut = document.getElementById('ficheStatutHidden');
    if (hiddenStatut) hiddenStatut.value = statut === 'brouillon' ? 'brouillon' : statut;
    document.getElementById('ficheBatiments').value = sb.NombreBatiments ?? sb.nombreBatiments ?? '';
    document.getElementById('ficheEtat').value = sb.EtatGeneral || sb.etatGeneral || 'Satisfaisant';
    document.getElementById('ficheEleves').value = sb.NombreEleves ?? sb.nombreEleves ?? '';
    parseToilet(sb.ToilettesFilles || sb.toilettesFilles || '', 'ficheFillesNb', 'ficheFillesEtat');
    parseToilet(sb.ToilettesGarcons || sb.toilettesGarcons || '', 'ficheGarconsNb', 'ficheGarconsEtat');
    syncAllToilets();
    document.getElementById('ficheMontant').value = si.MontantPercu || si.montantPercu || '';
    document.getElementById('ficheQuantite').value = si.Quantite || si.quantite || '';
    document.getElementById('ficheAutres').value = f.ProduitsAutres || f.produitsAutres || '';
    document.getElementById('ficheObs').value = f.Observations || f.observations || '';
    document.getElementById('ficheReco').value = f.RecommandationPreliminaire || f.recommandationPreliminaire || 'Maintien';
    var produits = si.ProduitsNettoyage || si.produitsNettoyage || [];
    document.querySelectorAll('.produit-check').forEach(function (x) {
      x.checked = produits.indexOf(x.value) >= 0;
    });
    photos = f.Photos || f.photos || [];
    renderPhotos();
    document.getElementById('ficheTitle').textContent = isValidee
      ? 'Fiche validée (lecture seule)'
      : isEnAttente
        ? 'Fiche en attente de validation (lecture seule)'
      : (canCreerFiche ? 'Modifier la fiche' : 'Consulter la fiche');
    form.querySelectorAll('input,select,textarea').forEach(function (el) {
      if (el.type !== 'hidden' && el.id !== 'photoInput') el.disabled = locked;
    });
    document.getElementById('photoLabel').classList.toggle('d-none', locked);
    syncSchool();
    syncAllToilets();
    goStep(1);
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.fiche-edit');
    if (btn) openFiche(btn);
  });

  document.getElementById('ficheModal')?.addEventListener('show.bs.modal', function (e) {
    var trigger = e.relatedTarget;
    if (!trigger) return;
    var btn = trigger.closest('.fiche-edit');
    if (btn) openFiche(btn);
  });

  document.querySelectorAll('.print-btn').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = {}, ecole = null, chef = null, ordre = null;
      try { f = JSON.parse(b.getAttribute('data-json') || '{}'); } catch (e) {}
      try { ecole = JSON.parse(b.getAttribute('data-ecole') || 'null'); } catch (e) {}
      try { chef = JSON.parse(b.getAttribute('data-chef') || 'null'); } catch (e) {}
      try { ordre = JSON.parse(b.getAttribute('data-ordre') || 'null'); } catch (e) {}
      var html = window.buildFichePrintHtml ? window.buildFichePrintHtml(f, ecole, chef, ordre) : null;
      if (window.openPrintPreview) window.openPrintPreview(b.dataset.title || 'Fiche', html);
      else window.print();
    });
  });

  goStep(1);
})();
</script>
<script src="~/js/pages/fiches.js" asp-append-version="true"></script>
}
