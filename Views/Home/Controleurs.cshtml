@model List<Controleur>
@{
    ViewData["Title"] = "Contrôleurs (membres)";
    var equipes = (List<RefItem>)ViewBag.Equipes;
    var chefIds = ViewBag.ChefControleurIds as HashSet<string> ?? new HashSet<string>();
    var canGerer = ViewBag.CanGerer as bool? == true;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Contrôleurs (membres)</h2>
        <p class="text-secondary mb-0">Membres d’équipe sans compte système — 1 login par équipe (chef d’équipe).</p>
    </div>
    @if (canGerer)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ctrlModal" id="btnNewCtrl">
            <i class="ti ti-plus me-1"></i> Nouveau membre
        </button>
    }
</div>
<form method="get" class="row g-2 mb-4" id="ctrlFilter">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Nom…" /></div>
    <div class="col-md-4">
        <select name="equipeId" class="form-select">
            <option value="">Toutes les équipes</option>
            @foreach (var e in equipes)
            {
                <option value="@e.Id" selected="@(ViewBag.EquipeId as string == e.Id)">@e.Nom</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrer</button></div>
</form>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table">
            <thead class="table-light"><tr><th>Nom</th><th>Téléphone</th><th>Équipe</th><th>Rôle équipe</th><th>Statut</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                var eq = equipes.FirstOrDefault(e => e.Id == c.EquipeId);
                var isChef = chefIds.Contains(c.Id);
                <tr>
                    <td class="fw-semibold">@c.NomComplet</td>
                    <td>@(c.Telephone ?? "—")</td>
                    <td>@(eq?.Nom ?? c.EquipeId)</td>
                    <td>
                        @if (isChef)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis">Chef d’équipe</span>
                        }
                        else
                        {
                            <span class="text-secondary">Membre</span>
                        }
                    </td>
                    <td>@(c.Actif ? Html.Raw("<span class='badge bg-success-subtle text-success-emphasis'>Actif</span>") : Html.Raw("<span class='badge bg-secondary'>Inactif</span>"))</td>
                    <td class="text-end text-nowrap">
                        @if (canGerer)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-ctrl"
                                    data-bs-toggle="modal" data-bs-target="#ctrlModal"
                                    data-id="@c.Id" data-nom="@c.NomComplet" data-tel="@c.Telephone"
                                    data-equipe="@c.EquipeId" data-actif="@(c.Actif ? "1" : "0")">
                                <i class="ti ti-edit"></i>
                            </button>
                            <form asp-action="DeleteControleur" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce membre ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-sm btn-outline-danger" @(isChef ? "disabled title=\"Chef d’équipe — re-désigner d’abord\"" : "")>
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="ctrlModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="SaveControleur" method="post" class="modal-content" id="ctrlForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon"><i class="ti ti-users-group"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Membre d’équipe</p>
                        <h5 class="modal-title" id="ctrlTitle">Nouveau membre</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="ctrlId" />
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-user"></i> Fiche membre</h6>
                    <div class="row g-3">
                        <div class="col-md-8"><label class="form-label">Nom complet</label><input name="NomComplet" id="ctrlNom" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">Téléphone</label><input name="Telephone" id="ctrlTel" class="form-control" /></div>
                        <div class="col-md-8">
                            <label class="form-label">Équipe</label>
                            <select name="EquipeId" id="ctrlEquipe" class="form-select" required>
                                <option value="">— Sélectionner —</option>
                                @foreach (var e in equipes) { <option value="@e.Id">@e.Nom</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Actif</label>
                            <select name="Actif" id="ctrlActif" class="form-select">
                                <option value="true">Oui</option>
                                <option value="false">Non</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script>
(function () {
  document.getElementById('btnNewCtrl')?.addEventListener('click', function () {
    document.getElementById('ctrlTitle').textContent = 'Nouveau membre';
    document.getElementById('ctrlForm').reset();
    document.getElementById('ctrlId').value = '';
  });
  document.querySelectorAll('.btn-edit-ctrl').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById('ctrlTitle').textContent = 'Modifier';
      document.getElementById('ctrlId').value = btn.getAttribute('data-id') || '';
      document.getElementById('ctrlNom').value = btn.getAttribute('data-nom') || '';
      document.getElementById('ctrlTel').value = btn.getAttribute('data-tel') || '';
      document.getElementById('ctrlEquipe').value = btn.getAttribute('data-equipe') || '';
      document.getElementById('ctrlActif').value = btn.getAttribute('data-actif') === '1' ? 'true' : 'false';
    });
  });
})();
</script>
}
