@model List<Rapport>
@{
    ViewData["Title"] = "Accusés de réception";
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var canAccuser = ViewBag.CanAccuser as bool? == true;
    var canTransmettre = ViewBag.CanTransmettre as bool? == true;
}
<div class="mb-4">
    <h2 class="mb-1">Accusés de réception</h2>
    <p class="text-secondary mb-0">Délivrance des accusés et transmission au Directeur Provincial.</p>
</div>
<div class="card card-lg mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Recherche</label>
                <input type="search" class="form-control" id="accuseSearch" placeholder="Rechercher un rapport ou une école…" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Statut</label>
                <select class="form-select" id="accuseStatut">
                    <option value="">Tous les statuts</option>
                    <option value="depose">Déposé (en attente d'accusé)</option>
                    <option value="accuse">Accusé (en attente de transmission)</option>
                    <option value="transmis">Transmis</option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="accusesTable" data-can-accuser="@(canAccuser ? "1" : "0")" data-can-transmettre="@(canTransmettre ? "1" : "0")">
            <thead class="table-light"><tr><th>Rapport</th><th>École</th><th>Statut</th><th></th></tr></thead>
            <tbody id="accusesTbody">
            @foreach (var r in Model)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == r.EcoleId);
                <tr data-statut="@r.Statut" data-search="@((r.Numero + " " + (eco?.Denomination ?? "")).ToLowerInvariant())">
                    <td class="fw-semibold">@r.Numero</td>
                    <td>@(eco?.Denomination ?? "—")</td>
                    <td><span class="badge bg-secondary-subtle text-dark">@r.Statut</span></td>
                    <td class="text-end text-nowrap">
                        @if (canAccuser && r.Statut == "depose")
                        {
                            <form class="d-inline js-accuser" data-id="@r.Id"><button type="submit" class="btn btn-sm btn-outline-primary"><i class="ti ti-mail-check me-1"></i>Accuser</button></form>
                        }
                        @if (canTransmettre && r.Statut == "accuse")
                        {
                            <form class="d-inline js-transmettre" data-id="@r.Id"><button type="submit" class="btn btn-sm btn-outline-success"><i class="ti ti-send me-1"></i>Transmettre DP</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/accuses.js" asp-append-version="true"></script>
}
