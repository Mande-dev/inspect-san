@model List<Chef>
@using System.Text.Json
@using inspect_san.Helpers
@{
    ViewData["Title"] = "Chefs d'établissement";
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var canGerer = ViewBag.CanGererChefs as bool? == true;
}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4 isp-page-head">
    <div>
        <h2 class="mb-1">Chefs d'établissement</h2>
        <p class="text-secondary mb-0">@(canGerer ? "Chefs d'établissement — assignés ensuite depuis la fiche établissement." : "Consultation des chefs d'établissement.")</p>
    </div>
    @if (canGerer)
    {
        <button type="button" class="btn btn-primary" id="newChef" data-bs-toggle="modal" data-bs-target="#chefModal">
            <i class="ti ti-plus me-1"></i>Nouveau chef
        </button>
    }
</div>

<div class="row g-3 mb-4" id="chefsStats">
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-primary-subtle text-primary-emphasis"><i class="ti ti-user-star fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statChefsTotal">@(ViewBag.StatTotal ?? 0)</h3><p class="mb-0 text-secondary small">Chefs au total</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-success-subtle text-success-emphasis"><i class="ti ti-building-community fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statChefsAssignes">@(ViewBag.StatAssignes ?? 0)</h3><p class="mb-0 text-secondary small">Assignés à une école</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-warning-subtle text-warning-emphasis"><i class="ti ti-user-question fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statChefsSansEcole">@(ViewBag.StatSansEcole ?? 0)</h3><p class="mb-0 text-secondary small">Sans établissement</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-info-subtle text-info-emphasis"><i class="ti ti-phone fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statChefsTel">@(ViewBag.StatAvecTel ?? 0)</h3><p class="mb-0 text-secondary small">Avec téléphone</p></div>
        </div></div>
    </div>
</div>
<form method="get" class="row g-2 mb-4" id="chefsFilter">
    <div class="col-12 col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Nom ou matricule…" /></div>
    <div class="col-12 col-md-4">
        <select name="ecoleId" class="form-select">
            <option value="">Tous les établissements</option>
            @foreach (var e in ecoles)
            {
                <option value="@e.Id" selected="@(ViewBag.EcoleId as string == e.Id)">@e.Denomination</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3 col-lg-2"><button class="btn btn-outline-primary w-100">Filtrer</button></div>
</form>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="chefsTable" data-can-gerer="@(canGerer ? "1" : "0")">
            <thead class="table-light">
                <tr><th>@DictionnaireDonnees.Label("Matr_Chef_Etab")</th><th>@DictionnaireDonnees.Label("Nom_Chef")</th><th>@DictionnaireDonnees.Label("Num_Tel_Chef")</th><th>E-mail</th><th>@DictionnaireDonnees.Label("Dénomination")</th><th>@DictionnaireDonnees.Label("Date_Deb_Act")</th><th></th></tr>
            </thead>
            <tbody id="chefsTbody">
            @foreach (var chef in Model)
            {
                var ecole = ecoles.FirstOrDefault(e => e.MatriculeChef == chef.Matricule);
                <tr>
                    <td class="font-monospace">@chef.Matricule</td>
                    <td class="fw-semibold">@chef.NomComplet</td>
                    <td>@chef.Telephone</td>
                    <td class="small">@(string.IsNullOrWhiteSpace(chef.Email) ? "—" : chef.Email)</td>
                    <td>@(ecole?.Denomination ?? "—")</td>
                    <td class="small">@(chef.AnneeDebutActivite?.ToString() ?? "—")</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary chef-open" data-mode="view" data-json="@JsonUi.Serialize(new { Id = chef.Matricule, chef.Matricule, chef.NomComplet, chef.Telephone, chef.Email, chef.AnneeDebutActivite })" data-bs-toggle="modal" data-bs-target="#chefModal"><i class="ti ti-eye"></i></button>
                        @if (canGerer)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary chef-open" data-mode="edit" data-json="@JsonUi.Serialize(new { Id = chef.Matricule, chef.Matricule, chef.NomComplet, chef.Telephone, chef.Email, chef.AnneeDebutActivite })" data-bs-toggle="modal" data-bs-target="#chefModal"><i class="ti ti-edit"></i></button>
                            <form class="d-inline js-delete-chef" data-id="@chef.Matricule">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="chefModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SaveChef" method="post" class="modal-content" id="chefForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-user-star"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Chef d'établissement</p>
                        <h5 class="modal-title" id="chefModalTitle">Nouveau chef</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="chefId" />
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-user"></i> Identité</h6>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">@DictionnaireDonnees.Label("Matr_Chef_Etab") <span class="text-danger">*</span></label><input name="Matricule" id="chefMatricule" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">@DictionnaireDonnees.Label("Num_Tel_Chef")</label><input name="Telephone" id="chefTel" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">@DictionnaireDonnees.Label("Nom_Chef") <span class="text-danger">*</span></label><input name="NomComplet" id="chefNom" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">E-mail</label><input type="email" name="Email" id="chefEmail" class="form-control" placeholder="ex. chef@ecole.cd" /></div>
                        <div class="col-md-6"><label class="form-label">@DictionnaireDonnees.Label("Date_Deb_Act")</label><input type="number" min="1950" max="2100" name="AnneeDebutActivite" id="chefAnneeDebut" class="form-control" /></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-primary" id="chefSave">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/chefs.js" asp-append-version="true"></script>
}
