@model List<Ecole>
@using inspect_san.Models.Constants
@{
    ViewData["Title"] = "Écoles";
    ViewBag.PageKey = "ecoles";
    var sousDivisions = (IEnumerable<RefItem>)ViewBag.Sousproveds;
    var regimes = (IEnumerable<RefItem>)ViewBag.Regimes;
    var categories = (IEnumerable<RefItem>)ViewBag.Categories;
    var chefsEtablissement = (IEnumerable<Chef>)(ViewBag.ChefsEtablissement ?? new List<Chef>());
    var canGerer = ViewBag.CanGererEcole as bool? == true;
}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4 isp-page-head">
    <div>
        <h2 class="mb-1">Établissements</h2>
        <p class="text-secondary mb-0">@(canGerer ? "Gestion des établissements scolaires contrôlés." : "Consultation des établissements.")</p>
    </div>
    @if (canGerer)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ecoleModal" id="btnNewEcole">
            <i class="ti ti-plus me-1"></i> Nouvel établissement
        </button>
    }
</div>

<div class="row g-3 mb-4" id="ecolesStats">
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-primary-subtle text-primary-emphasis"><i class="ti ti-building-community fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statEcolesTotal">@(ViewBag.StatTotal ?? 0)</h3><p class="mb-0 text-secondary small">Écoles au total</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-success-subtle text-success-emphasis"><i class="ti ti-user-star fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statEcolesAvecChef">@(ViewBag.StatAvecChef ?? 0)</h3><p class="mb-0 text-secondary small">Avec chef assigné</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-warning-subtle text-warning-emphasis"><i class="ti ti-alert-circle fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statEcolesSansChef">@(ViewBag.StatSansChef ?? 0)</h3><p class="mb-0 text-secondary small">Sans chef</p></div>
        </div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card card-lg h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="icon-shape icon-lg rounded-circle bg-info-subtle text-info-emphasis"><i class="ti ti-category fs-3"></i></div>
            <div class="min-w-0"><h3 class="mb-0" id="statEcolesRegimes">@(ViewBag.StatRegimes ?? 0)</h3><p class="mb-0 text-secondary small">Régimes différents</p></div>
        </div></div>
    </div>
</div>

<form method="get" class="row g-2 mb-4" id="ecolesFilter">
    <div class="col-12 col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Recherche…" /></div>
    <div class="col-12 col-sm-6 col-md-3">
        <select name="sousproved" class="form-select">
            <option value="">Toutes sous-divisions</option>
            @foreach (var c in sousDivisions) { <option value="@c.Nom" selected="@(ViewBag.Sousproved as string == c.Nom)">@c.Nom</option> }
        </select>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <select name="regime" class="form-select">
            <option value="">Tous régimes</option>
            @foreach (var r in regimes) { <option value="@r.Nom" selected="@(ViewBag.Regime as string == r.Nom)">@r.Nom</option> }
        </select>
    </div>
    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filtrer</button></div>
</form>

<div class="card card-lg">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 js-paginated-table" id="ecolesTable" data-can-gerer="@(canGerer ? "1" : "0")">
                <thead class="table-light">
                    <tr>
                        <th>Dénomination</th>
                        <th>N° agrément</th>
                        <th>DINACOPE</th>
                        <th>Régime</th>
                        <th>Sous-division</th>
                        <th>Catégorie</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="ecolesTbody">
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.Denomination</td>
                        <td>@e.NumAgrement</td>
                        <td>@e.IdDinacope</td>
                        <td>@RegGes.LabelOf(e.RegGes)</td>
                        <td>@SousDivision.LabelOf(e.SousDivision)</td>
                        <td>@(e.Categorie?.Designation ?? e.CodeCategories.ToString())</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-edit-ecole"
                                    data-id="@e.Id"
                                    data-denomination="@e.Denomination"
                                    data-regges="@e.RegGes"
                                    data-sousdivision="@e.SousDivision"
                                    data-categories="@e.CodeCategories"
                                    data-dinacope="@e.IdDinacope"
                                    data-agrement="@e.NumAgrement"
                                    data-notif="@e.NumNotification"
                                    data-chef="@e.MatriculeChef"
                                    data-adresse="@e.Adresse"
                                    data-readonly="1"
                                    data-bs-toggle="modal" data-bs-target="#ecoleModal"><i class="ti ti-eye"></i></button>
                            @if (canGerer)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary btn-edit-ecole"
                                        data-id="@e.Id"
                                        data-denomination="@e.Denomination"
                                        data-regges="@e.RegGes"
                                        data-sousdivision="@e.SousDivision"
                                        data-categories="@e.CodeCategories"
                                        data-dinacope="@e.IdDinacope"
                                        data-agrement="@e.NumAgrement"
                                        data-notif="@e.NumNotification"
                                        data-chef="@e.MatriculeChef"
                                        data-adresse="@e.Adresse"
                                        data-readonly="0"
                                        data-bs-toggle="modal" data-bs-target="#ecoleModal"><i class="ti ti-edit"></i></button>
                                <form class="d-inline js-delete-ecole" data-id="@e.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade isp-modal" id="ecoleModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <form asp-action="SaveEcole" method="post" class="modal-content" id="ecoleForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="ecoleModalTitle">Nouvel établissement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="formId" />
                <input type="hidden" name="Adresse" id="formAdresse" />
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label">Dénomination</label><input name="Denomination" id="formDenomination" class="form-control" required /></div>
                    <div class="col-md-4"><label class="form-label">N° agrément</label><input name="NumAgrement" id="formAgrement" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Régime</label>
                        <select name="RegGes" id="formRegGes" class="form-select" required>
                            @foreach (var code in RegGes.All) { <option value="@code">@RegGes.LabelOf(code)</option> }
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label">Sous-division</label>
                        <select name="SousDivision" id="formSousDivision" class="form-select" required>
                            @foreach (var c in sousDivisions) { <option value="@c.Code">@c.Nom</option> }
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label">Catégorie</label>
                        <select name="CodeCategories" id="formCategories" class="form-select" required>
                            @foreach (var c in categories) { <option value="@c.Code">@c.Nom</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label">ID DINACOPE</label><input name="IdDinacope" id="formDinacope" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">N° notification</label><input name="NumNotification" id="formNotif" class="form-control" /></div>
                    <div class="col-md-12"><label class="form-label">Chef d'établissement</label>
                        <select name="MatriculeChef" id="formChef" class="form-select">
                            <option value="">— Aucun —</option>
                            @foreach (var p in chefsEtablissement)
                            {
                                <option value="@p.Matricule">@p.NomComplet (@p.Matricule)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Adresse</label>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input type="text" id="formAdresseAv" class="form-control" placeholder="AV / Avenue" required />
                            </div>
                            <div class="col-md-2">
                                <input type="text" id="formAdresseNumero" class="form-control" placeholder="N°" required />
                            </div>
                            <div class="col-md-3">
                                <input type="text" id="formAdresseQuartier" class="form-control" placeholder="Quartier" required />
                            </div>
                            <div class="col-md-3">
                                <input type="text" id="formAdresseCommune" class="form-control" placeholder="Commune" required />
                            </div>
                        </div>
                        <div class="form-text">L’adresse complète est assemblée automatiquement (AV, N°, Quartier, Commune).</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="submit" class="btn btn-primary" id="ecoleSave">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/ecoles.js" asp-append-version="true"></script>
}
