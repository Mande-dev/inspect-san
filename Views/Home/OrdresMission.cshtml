@model List<OrdreMission>
@using System.Text.Json
@using inspect_san.Helpers
@{
    ViewData["Title"] = "Ordres de mission";
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var equipes = (List<RefItem>)(ViewBag.Equipes ?? new List<RefItem>());
    var canSigner = ViewBag.CanSigner as bool? == true;
    var canGerer = ViewBag.CanGererOrdre as bool? == true;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Ordres de mission</h2>
        <p class="text-secondary mb-0">Planification et signature des missions de contrôle.</p>
    </div>
    @if (canGerer)
    {
        <button type="button" class="btn btn-primary" id="newOrdre" data-bs-toggle="modal" data-bs-target="#ordreModal">
            <i class="ti ti-plus me-1"></i>Nouvel ordre
        </button>
    }
</div>
<form method="get" class="row g-2 mb-4" id="ordresFilter">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="N° d'ordre…" /></div>
    <div class="col-md-4">
        <select name="statut" class="form-select">
            <option value="">Tous les statuts</option>
            @foreach (var s in new[] { "brouillon", "en_attente_signature", "signe", "en_cours", "cloture" })
            {
                <option value="@s" selected="@(ViewBag.Statut as string == s)">@s.Replace("_", " ")</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrer</button></div>
</form>
<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="ordresTable" data-can-signer="@(canSigner ? "1" : "0")" data-can-gerer="@(canGerer ? "1" : "0")">
            <thead class="table-light"><tr><th>Numéro</th><th>École</th><th>Équipe</th><th>Validité</th><th>Statut</th><th></th></tr></thead>
            <tbody id="ordresTbody">
            @foreach (var ordre in Model)
            {
                var ecole = ecoles.FirstOrDefault(e => e.Id == ordre.EcoleId);
                var equipeNom = ordre.Equipe?.Nom ?? equipes.FirstOrDefault(e => e.Id == ordre.EquipeId)?.Nom ?? ordre.EquipeId;
                // Payload plat : éviter le cycle EF Ecole.Regime.Ecoles…
                var ordreJson = JsonUi.Serialize(new
                {
                    ordre.Id,
                    ordre.Numero,
                    ordre.EcoleId,
                    ordre.EquipeId,
                    ordre.Statut,
                    ordre.DateEmission,
                    ordre.DebutValidite,
                    ordre.FinValidite,
                    ordre.DateMission,
                    ordre.SigneLe,
                    ordre.SignePar,
                    ordre.Objet
                });
                var ecoleJson = JsonUi.Serialize(ecole == null ? null : new
                {
                    ecole.Id,
                    ecole.Denomination,
                    ecole.RegimeId,
                    ecole.CommuneId,
                    ecole.IdDinacope,
                    ecole.NumAgrement,
                    ecole.NumNotification,
                    ecole.Adresse,
                    ecole.Statut,
                    Regime = ecole.Regime?.Nom,
                    Commune = ecole.Commune?.Nom
                });
                <tr>
                    <td class="fw-semibold">@ordre.Numero</td>
                    <td>@(ecole?.Denomination ?? "—")</td>
                    <td>@equipeNom</td>
                    <td class="small">@(ordre.DebutValidite?.ToString("dd/MM/yyyy") ?? "—") – @(ordre.FinValidite?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td><span class="badge bg-secondary-subtle text-dark">@ordre.Statut.Replace("_", " ")</span></td>
                    <td class="text-end text-nowrap">
                        @if (canGerer)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary ordre-edit" data-json="@ordreJson" data-bs-toggle="modal" data-bs-target="#ordreModal"><i class="ti ti-edit"></i></button>
                        }
                        @if (canSigner && (ordre.Statut == "brouillon" || ordre.Statut == "en_attente_signature"))
                        {
                            <form class="d-inline js-signer-ordre" data-id="@ordre.Id"><button type="submit" class="btn btn-sm btn-outline-success" title="Signer"><i class="ti ti-signature"></i></button></form>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary print-btn"
                                data-title="Ordre @ordre.Numero"
                                data-json="@ordreJson"
                                data-ecole="@ecoleJson"
                                data-controleurs="@equipeNom"
                                data-signataire=""><i class="ti ti-printer"></i></button>
                        @if (canGerer)
                        {
                            <form class="d-inline js-delete-ordre" data-id="@ordre.Id"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="ordreModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SaveOrdre" method="post" class="modal-content" id="ordreForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-clipboard-list"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Ordre de mission</p>
                        <h5 class="modal-title" id="ordreTitle">Nouvel ordre</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="ordreId" />
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-file-description"></i> Paramètres de mission</h6>
                    <div class="row g-3">
                        <div class="col-12 d-none" id="ordreNumeroWrap">
                            <label class="form-label text-secondary">N° d'ordre</label>
                            <p class="fw-semibold mb-0 font-monospace" id="ordreNumeroDisplay">—</p>
                            <p class="small text-secondary mb-0">Attribué automatiquement à la création.</p>
                        </div>
                        <div class="col-md-6"><label class="form-label">Statut</label>
                            <select name="Statut" id="ordreStatut" class="form-select">
                                <option value="brouillon">Brouillon</option>
                                <option value="en_attente_signature">En attente de signature</option>
                                <option value="signe">Signé</option>
                                <option value="en_cours">En cours</option>
                                <option value="cloture">Clôturé</option>
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">École <span class="text-danger">*</span></label>
                            <select name="EcoleId" id="ordreEcole" class="form-select" required>
                                <option value="">Sélectionner…</option>
                                @foreach (var e in ecoles) { <option value="@e.Id">@e.Denomination</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Date d'émission</label><input type="date" name="DateEmission" id="ordreEmission" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Début de validité</label><input type="date" name="DebutValidite" id="ordreDebut" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Fin de validité</label><input type="date" name="FinValidite" id="ordreFin" class="form-control" /></div>
                        <div class="col-12">
                            <label class="form-label">Équipe <span class="text-danger">*</span></label>
                            <select name="EquipeId" id="ordreEquipe" class="form-select" required>
                                <option value="">Sélectionner…</option>
                                @foreach (var eq in equipes.Where(x => x.Actif))
                                {
                                    <option value="@eq.Id">@eq.Nom</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/ordres.js" asp-append-version="true"></script>
}
