@{
    ViewData["Title"] = "Statistiques";
    var sousproveds = (List<RefItem>)(ViewBag.Sousproveds ?? new List<RefItem>());
    var regimes = (List<RefItem>)(ViewBag.Regimes ?? new List<RefItem>());
}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4 isp-page-head">
    <div>
        <h2 class="mb-1">Statistiques</h2>
        <p class="text-secondary mb-0">Indicateurs de conformité, de contrôle et d'utilisation des ressources.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" id="exportCsv"><i class="ti ti-file-spreadsheet me-1"></i>CSV</button>
        <button type="button" class="btn btn-outline-primary" id="exportPdf"><i class="ti ti-printer me-1"></i>PDF</button>
    </div>
</div>

<div class="card card-lg mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-2"><label class="form-label">Du</label><input type="date" class="form-control" id="filterDateFrom" /></div>
            <div class="col-6 col-md-2"><label class="form-label">Au</label><input type="date" class="form-control" id="filterDateTo" /></div>
            <div class="col-12 col-md-3">
                <label class="form-label">@DictionnaireDonnees.Label("Lib_Sous")</label>
                <select class="form-select" id="filterSousproved">
                    <option value="">Toutes</option>
                    @foreach (var c in sousproveds) { <option value="@c.Nom">@c.Nom</option> }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">@DictionnaireDonnees.Label("Reg_Ges")</label>
                <select class="form-select" id="filterRegime">
                    <option value="">Tous</option>
                    @foreach (var r in regimes) { <option value="@r.Nom">@r.Nom</option> }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="button" class="btn btn-outline-secondary w-100" id="resetFilters" title="Réinitialiser"><i class="ti ti-refresh me-1"></i><span class="d-md-none">Réinitialiser</span></button>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-md-3"><div class="card card-lg h-100"><div class="card-body"><div class="text-secondary small">@DictionnaireDonnees.Label("Tot_Gen") (écoles)</div><div class="fs-3 fw-bold" id="kpiEcoles">—</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card card-lg h-100"><div class="card-body"><div class="text-secondary small">Fiches de contrôle</div><div class="fs-3 fw-bold" id="kpiFiches">—</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card card-lg h-100"><div class="card-body"><div class="text-secondary small">Taux de conformité</div><div class="fs-3 fw-bold" id="kpiConformite">—</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card card-lg h-100"><div class="card-body"><div class="text-secondary small">@DictionnaireDonnees.Label("Décision_Fin") (prises)</div><div class="fs-3 fw-bold" id="kpiDecisions">—</div></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4"><div class="card card-lg h-100"><div class="card-header">Conformité (@DictionnaireDonnees.Label("Etat_Bat"))</div><div class="card-body"><div id="chartConformite" style="min-height:280px"></div></div></div></div>
    <div class="col-lg-4"><div class="card card-lg h-100"><div class="card-header">Répartition — @DictionnaireDonnees.Label("Décision_Fin")</div><div class="card-body"><div id="chartDecisions" style="min-height:280px"></div></div></div></div>
    <div class="col-lg-4"><div class="card card-lg h-100"><div class="card-header">@DictionnaireDonnees.Label("Dési_Prod_Net")</div><div class="card-body"><div id="chartProduits" style="min-height:280px"></div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-12"><div class="card card-lg"><div class="card-header">Évolution des contrôles (@DictionnaireDonnees.Label("Tot_Div"))</div><div class="card-body"><div id="chartEvolution" style="min-height:300px"></div></div></div></div>
</div>

@section Scripts {
<script src="~/js/pages/statistiques.js" asp-append-version="true"></script>
}
