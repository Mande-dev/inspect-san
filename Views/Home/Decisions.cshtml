@model List<Decision>
@{
    ViewData["Title"] = "Décisions";
    var types = (List<RefItem>)ViewBag.Types;
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var rapports = (List<Rapport>)ViewBag.Rapports;
    var sansDecision = (List<Rapport>)(ViewBag.RapportsSansDecision ?? new List<Rapport>());
    var canCreer = ViewBag.CanCreerDecision as bool? == true;
    var sansIds = sansDecision.Select(r => r.Id).ToHashSet(StringComparer.Ordinal);
    // En édition : rapports déjà liés à une décision (souvent « traite »)
    var rapportsLies = Model
        .Select(d => rapports.FirstOrDefault(r => r.Id == d.RapportId))
        .Where(r => r != null && !sansIds.Contains(r!.Id))
        .Cast<Rapport>()
        .GroupBy(r => r.Id)
        .Select(g => g.First())
        .ToList();
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Décisions</h2>
        <p class="text-secondary mb-0">@(canCreer ? "Une décision par rapport transmis. L’école est celle du rapport." : "Suivi des décisions concernant votre établissement.")</p>
    </div>
    @if (canCreer)
    {
        <button class="btn btn-primary" id="newDecision" data-bs-toggle="modal" data-bs-target="#decisionModal"><i class="ti ti-plus me-1"></i>Nouvelle décision</button>
    }
</div>

@if (canCreer)
{
<div id="sansDecisionAlert" class="alert alert-warning @(sansDecision.Any() ? "" : "d-none")">
@if (sansDecision.Any())
{
        <strong>Rapports transmis sans décision :</strong>
        <ul class="mb-0 mt-2">
            @foreach (var r in sansDecision)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == r.EcoleId);
                <li>@r.Numero — @(eco?.Denomination)
                    <button type="button" class="btn btn-sm btn-outline-dark ms-2 decide-from" data-rapport="@r.Id" data-ecole="@r.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")" data-bs-toggle="modal" data-bs-target="#decisionModal">Prendre une décision</button>
                </li>
            }
        </ul>
}
</div>
}

<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="decisionsTable" data-can-creer="@(canCreer ? "1" : "0")">
            <thead class="table-light"><tr><th>N°</th><th>Type</th><th>École</th><th>Délai</th><th>Exécution</th><th></th></tr></thead>
            <tbody id="decisionsTbody">
            @foreach (var d in Model)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == d.EcoleId);
                var typeLabel = d.TypeDecision?.Nom ?? d.TypeDecision?.Code ?? "—";
                <tr>
                    <td class="fw-semibold">@(string.IsNullOrEmpty(d.Numero) ? d.Id : d.Numero)</td>
                    <td>@typeLabel</td>
                    <td>@(eco?.Denomination ?? "—")</td>
                    <td>@(d.DelaiExecution ?? "—")</td>
                    <td>@d.StatutExecution</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-voir-decision"
                                data-id="@d.Id" data-rapport="@d.RapportId" data-ecole="@d.EcoleId"
                                data-ecole-nom="@(eco?.Denomination ?? "")"
                                data-type="@d.TypeDecisionId" data-delai="@(d.DelaiExecution ?? "")"
                                data-exec="@d.StatutExecution" data-commentaire="@(d.Commentaire ?? d.Motif ?? "")"
                                data-readonly="1" data-bs-toggle="modal" data-bs-target="#decisionModal" title="Voir"><i class="ti ti-eye"></i></button>
                        @if (canCreer)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-decision"
                                    data-id="@d.Id" data-rapport="@d.RapportId" data-ecole="@d.EcoleId"
                                    data-ecole-nom="@(eco?.Denomination ?? "")"
                                    data-type="@d.TypeDecisionId" data-delai="@(d.DelaiExecution ?? "")"
                                    data-exec="@d.StatutExecution" data-commentaire="@(d.Commentaire ?? d.Motif ?? "")"
                                    data-readonly="0" data-bs-toggle="modal" data-bs-target="#decisionModal" title="Modifier"><i class="ti ti-edit"></i></button>
                            <form class="d-inline js-delete-decision" data-id="@d.Id"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="decisionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SaveDecision" method="post" class="modal-content" id="decisionForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-gavel"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Décision</p>
                        <h5 class="modal-title" id="decisionTitle">Nouvelle décision</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="decId" />
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-scale"></i> Contenu de la décision</h6>
                    <div class="mb-3">
                        <label class="form-label">Rapport concerné</label>
                        <select name="RapportId" id="decRapport" class="form-select" required>
                            <option value="">Sélectionner…</option>
                            @foreach (var r in sansDecision)
                            {
                                var eco = ecoles.FirstOrDefault(e => e.Id == r.EcoleId);
                                <option value="@r.Id" data-ecole="@r.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")" data-eligible="1">@r.Numero — @(eco?.Denomination)</option>
                            }
                            @foreach (var r in rapportsLies)
                            {
                                var eco = ecoles.FirstOrDefault(e => e.Id == r.EcoleId);
                                <option value="@r.Id" data-ecole="@r.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")" data-eligible="0">@r.Numero — @(eco?.Denomination)</option>
                            }
                        </select>
                        <div class="form-text">Création : uniquement les rapports transmis sans décision.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">École (issue du rapport)</label>
                        <input type="hidden" name="EcoleId" id="decEcole" />
                        <input type="text" id="decEcoleLabel" class="form-control" readonly tabindex="-1" placeholder="Sélectionnez un rapport" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type de décision</label>
                        <select name="TypeDecisionId" id="decType" class="form-select" required>
                            @foreach (var t in types) { <option value="@t.Id">@(t.Libelle ?? t.Nom)</option> }
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label">Délai d'exécution</label><input name="DelaiExecution" id="decDelai" class="form-control" placeholder="Ex. 15 jours" /></div>
                    <div class="mb-3">
                        <label class="form-label">Statut d'exécution</label>
                        <select name="StatutExecution" id="decExec" class="form-select">
                            <option value="en_attente">En attente</option>
                            <option value="en_cours">En cours</option>
                            <option value="executee">Exécutée</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Commentaire / Motif</label>
                        <textarea name="Commentaire" id="decCommentaire" class="form-control" rows="3"></textarea>
                        <input type="hidden" name="Motif" id="decMotif" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button class="btn btn-primary" id="decisionSave">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/decisions.js" asp-append-version="true"></script>
}
