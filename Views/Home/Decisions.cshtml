@model List<Decision>
@using System.Text.Json
@using inspect_san.Models.Constants
@{
    ViewData["Title"] = "Décisions";
    var types = (IReadOnlyDictionary<string, string>)(ViewBag.TypesDecision ?? DecisionTypes.Labels);
    var ecoles = (List<Ecole>)ViewBag.Ecoles;
    var fiches = (List<FicheControle>)(ViewBag.Fiches ?? new List<FicheControle>());
    var sansDecision = (List<FicheControle>)(ViewBag.FichesSansDecision ?? new List<FicheControle>());
    var produits = ((IEnumerable<RefItem>)(ViewBag.Produits ?? Enumerable.Empty<RefItem>()))
        .Select(p => (Ok: int.TryParse(p.Code, out var c), Code: c, Nom: p.Libelle ?? p.Nom))
        .Where(x => x.Ok)
        .GroupBy(x => x.Code)
        .ToDictionary(g => g.Key, g => g.First().Nom);
    var outils = ((IEnumerable<RefItem>)(ViewBag.Outils ?? Enumerable.Empty<RefItem>()))
        .Select(o => (Ok: int.TryParse(o.Code, out var c), Code: c, Nom: o.Libelle ?? o.Nom))
        .Where(x => x.Ok)
        .GroupBy(x => x.Code)
        .ToDictionary(g => g.Key, g => g.First().Nom);
    var canCreer = ViewBag.CanCreerDecision as bool? == true;
    var sansIds = sansDecision.Select(f => f.Id).ToHashSet(StringComparer.Ordinal);
    var fichesLiees = Model
        .Select(d => fiches.FirstOrDefault(f => f.Id == d.FicheControleId))
        .Where(f => f != null && !sansIds.Contains(f!.Id))
        .Cast<FicheControle>()
        .GroupBy(f => f.Id)
        .Select(g => g.First())
        .ToList();
    var fichesPreview = sansDecision.Concat(fichesLiees).GroupBy(f => f.Id).Select(g => g.First()).ToList();
}
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4 isp-page-head">
    <div>
        <h2 class="mb-1">Décisions</h2>
        <p class="text-secondary mb-0">@(canCreer ? "Une décision par fiche validée, après transfert du rapport par le secrétariat. Consultez la fiche avant de décider." : "Suivi des décisions concernant votre établissement.")</p>
    </div>
    @if (canCreer)
    {
        <button class="btn btn-primary" id="newDecision" data-bs-toggle="modal" data-bs-target="#decisionModal"><i class="ti ti-plus me-1"></i>Nouvelle décision</button>
    }
</div>

@if (canCreer)
{
<div id="sansDecisionAlert" class="alert alert-warning @(sansDecision.Any() ? "" : "d-none")">
@if (sansDecision.Any())
{
        <strong>Fiches transférées (rapport) sans décision :</strong>
        <ul class="mb-0 mt-2">
            @foreach (var f in sansDecision)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
                <li class="mb-2">
                    @f.Numero — @(eco?.Denomination)
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-2 btn-voir-fiche"
                            data-fiche-id="@f.Id">Voir la fiche</button>
                    <button type="button" class="btn btn-sm btn-outline-dark ms-1 decide-from"
                            data-fiche="@f.Id" data-ecole="@f.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")"
                            data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")"
                            data-bs-toggle="modal" data-bs-target="#decisionModal">Prendre une décision</button>
                </li>
            }
        </ul>
}
</div>
}

<div class="card card-lg">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-paginated-table" id="decisionsTable" data-can-creer="@(canCreer ? "1" : "0")">
            <thead class="table-light"><tr><th>N°</th><th>Type</th><th>École</th><th>Fiche</th><th></th></tr></thead>
            <tbody id="decisionsTbody">
            @foreach (var d in Model)
            {
                var eco = ecoles.FirstOrDefault(e => e.Id == d.EcoleId);
                var typeLabel = DecisionTypes.LabelOf(d.TypeDecision);
                <tr>
                    <td class="fw-semibold">@(string.IsNullOrEmpty(d.Numero) ? d.Id : d.Numero)</td>
                    <td>@(string.IsNullOrEmpty(typeLabel) ? "—" : typeLabel)</td>
                    <td>@(eco?.Denomination ?? "—")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(d.FicheControleId))
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 btn-voir-fiche" data-fiche-id="@d.FicheControleId">Voir</button>
                        }
                        else { <span>—</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-dark btn-print-decision"
                                data-id="@d.Id"
                                data-numero="@(string.IsNullOrEmpty(d.Numero) ? d.Id : d.Numero)"
                                data-fiche="@d.FicheControleId"
                                data-ecole="@d.EcoleId"
                                data-ecole-nom="@(eco?.Denomination ?? "")"
                                data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")"
                                data-type="@d.TypeDecision"
                                data-type-label="@typeLabel"
                                title="Imprimer la lettre de décision"><i class="ti ti-printer"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-voir-decision"
                                data-id="@d.Id" data-fiche="@d.FicheControleId" data-ecole="@d.EcoleId"
                                data-ecole-nom="@(eco?.Denomination ?? "")"
                                data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")"
                                data-type="@d.TypeDecision"
                                data-readonly="1" data-bs-toggle="modal" data-bs-target="#decisionModal" title="Voir"><i class="ti ti-eye"></i></button>
                        @if (canCreer)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-decision"
                                    data-id="@d.Id" data-fiche="@d.FicheControleId" data-ecole="@d.EcoleId"
                                    data-ecole-nom="@(eco?.Denomination ?? "")"
                                    data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")"
                                    data-type="@d.TypeDecision"
                                    data-readonly="0" data-bs-toggle="modal" data-bs-target="#decisionModal" title="Modifier"><i class="ti ti-edit"></i></button>
                            <form class="d-inline js-delete-decision" data-id="@d.Id"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade isp-modal" id="decisionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="SaveDecision" method="post" class="modal-content" id="decisionForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-gavel"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Décision</p>
                        <h5 class="modal-title" id="decisionTitle">Nouvelle décision</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="decId" />
                <div class="isp-modal-section mb-0">
                    <h6 class="isp-modal-section-title"><i class="ti ti-scale"></i> Contenu de la décision</h6>
                    <div class="mb-3">
                        <label class="form-label">Fiche concernée</label>
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <select name="FicheControleId" id="decFiche" class="form-select" required>
                                <option value="">Sélectionner…</option>
                                @foreach (var f in sansDecision)
                                {
                                    var eco = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
                                    <option value="@f.Id" data-ecole="@f.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")" data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")" data-eligible="1">@f.Numero — @(eco?.Denomination)</option>
                                }
                                @foreach (var f in fichesLiees)
                                {
                                    var eco = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
                                    <option value="@f.Id" data-ecole="@f.EcoleId" data-ecole-nom="@(eco?.Denomination ?? "")" data-chef-nom="@(eco?.ChefEtablissement?.NomComplet ?? "")" data-eligible="0">@f.Numero — @(eco?.Denomination)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-secondary text-nowrap flex-shrink-0" id="btnVoirFicheDecision" title="Consulter la fiche">
                                <i class="ti ti-file-search"></i> Voir la fiche
                            </button>
                        </div>
                        <div class="form-text">Consultez la fiche avant d’enregistrer. Création : fiches validées déjà transférées au DP, sans décision.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">École (issue de la fiche)</label>
                        <input type="hidden" name="EcoleId" id="decEcole" />
                        <input type="text" id="decEcoleLabel" class="form-control" readonly tabindex="-1" placeholder="Sélectionnez une fiche" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Type de décision</label>
                        <select name="TypeDecision" id="decType" class="form-select" required>
                            @foreach (var t in types) { <option value="@t.Key">@t.Value</option> }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-outline-dark" id="btnApercuLettreDecision" title="Aperçu / impression de la lettre officielle">
                    <i class="ti ti-printer me-1"></i>Aperçu lettre
                </button>
                <button class="btn btn-primary" id="decisionSave">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade isp-modal isp-modal--detail" id="fichePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xxl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="isp-modal-heading">
                    <span class="isp-modal-icon" aria-hidden="true"><i class="ti ti-file-search"></i></span>
                    <div>
                        <p class="isp-modal-kicker">Consultation</p>
                        <h5 class="modal-title">Fiche de contrôle (lecture seule)</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body isp-fiche-detail" id="fichePreviewBody">
                <p class="text-secondary mb-0">Sélectionnez une fiche.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="fichesPreviewJson">@Html.Raw(JsonSerializer.Serialize(fichesPreview.Select(f => {
    var eco = ecoles.FirstOrDefault(e => e.Id == f.EcoleId);
    return new {
        Id = f.Id,
        Numero = f.Numero,
        MissionId = f.MissionId,
        EcoleNom = eco?.Denomination ?? "",
        Statut = f.Statut,
        EtatGeneral = f.EtatGeneral,
        NombreBatiments = f.NombreBatiments,
        NombreEleves = f.NombreEleves,
        ToilettesFilles = f.ToilettesFilles,
        ToilettesGarcons = f.ToilettesGarcons,
        ProduitsAutres = f.ProduitsAutres,
        ProduitsAutresQuantite = f.ProduitsAutresQuantite,
        OutilsAutres = f.OutilsAutres,
        OutilsAutresQuantite = f.OutilsAutresQuantite,
        Observations = f.Observations,
        RecommandationPreliminaire = f.RecommandationPreliminaire,
        ControleProduits = f.ControleProduits.Select(cp => new {
            ProduitCode = cp.ProduitCode,
            ProduitNom = produits.GetValueOrDefault(cp.ProduitCode),
            Quantite = cp.Quantite
        }),
        ControleOutils = f.ControleOutils.Select(co => new {
            OutilCode = co.OutilCode,
            OutilNom = outils.GetValueOrDefault(co.OutilCode),
            Quantite = co.Quantite
        }),
        Photos = (f.Photos ?? []).Select(p => new {
            p.Nom,
            p.Legende,
            p.Url,
            NumOrdre = f.Numero,
            MissionId = f.MissionId
        })
    };
})))</script>

@section Scripts {
<script src="~/js/pages/decisions.js" asp-append-version="true"></script>
}
