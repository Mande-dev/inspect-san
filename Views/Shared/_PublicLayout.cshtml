<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(ViewData["Title"] ?? "Inspect-San") — Contrôle sanitaire scolaire</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/favicon/favicon-32x32.png" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="isp-public @(ViewData["BodyClass"])">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
